# OpenGrok — copy to .env. Every value here is a knob the server reads; nothing is invented
# elsewhere. See docs/RUNBOOK.md §3.

# Where the Sand gateway listens for the desktop client.
# NOT loopback: the client throws if its gateway host starts with 127.0.0.1 or localhost.
# See docs/RUNBOOK.md §1 for the /etc/hosts alias this implies.
OG_BIND=0.0.0.0:1337

# Postgres. Default reuses the gateway's dev instance with its own database, so a developer
# runs one database server rather than two.
OG_DATABASE_URL=postgres://oag:oag@127.0.0.1:5452/opengrok

# Signs our access tokens. Required — no default, so two deployments can never share a key by
# accident. Generate with: openssl rand -hex 32
OG_TOKEN_SECRET=

# Encrypts connector credentials at rest. Required once connectors are in use, and deliberately
# without a default: a default would mean every deployment that forgot to set one shares a key, and
# a token sealed on anybody's laptop would open here. Generate with: openssl rand -base64 32
OG_CREDENTIAL_KEK=

# The shared secret with the desktop client. Must equal SAND_HOST_GATEWAY_TOKEN on the client.
SAND_GATEWAY_TOKEN=

# The model door. `mock` runs the whole stack with no provider, no key and no spend — what CI uses
# and what makes the streaming path testable at all. Anything else uses the gateway below.
OG_MODEL_DOOR=

# Which route to ask the gateway for. A catalogue id (`oag/cheap`, `xai/grok-4.6`), not a key.
OG_MODEL=oag/cheap

# open-ai-gateway: the model door. The key is an oag_live_ key and NEVER a provider key —
# a coworker's pin is a route, not a credential (CLAUDE.md #4).
OG_GATEWAY_URL=http://127.0.0.1:29080
OG_GATEWAY_TOKEN=

# Where a coworker's computer comes from. Unset picks box.ascii.dev if OG_BOX_API_KEY is set and
# local Docker otherwise, so a laptop with a Docker daemon needs no account anywhere.
#   docker | ascii | none
OG_COMPUTER=

# Connector providers: a JSON list of provider configurations. Holds client secrets, so its file
# permissions are the guard. Unset means no connector is offered, which is a valid deployment.
#   [{"connector":"gmail","authorize_url":"...","token_url":"...","client_id":"...",
#     "client_secret":"...","scopes":["..."],"offline":true}]
OG_CONNECTORS=

# Where a provider sends a browser back. Must match the app registration byte for byte.
OG_OAUTH_REDIRECT_URI=http://127.0.0.1:1337/connections/callback

# Agent Plugins installed on this server, one directory each. Installing makes a plugin available;
# a coworker still needs its tools in their ceiling before they run.
OG_PLUGINS_DIR=

# box.ascii.dev, for hosted computers that outlive this machine.
OG_BOX_API_KEY=

# The image a Docker computer is built from. Any image with a shell.
OG_DOCKER_IMAGE=debian:stable-slim

RUST_LOG=opengrok=debug,opengrok_server=debug,opengrok_harness=debug

# Resend (resend.com) — transactional email for signup verification and (later) password reset.
# Unset ⇒ signup auto-verifies (no email). Set ⇒ verification email is sent and required.
# OG_RESEND_API_KEY=re_...
# The sender identity; RESEND_FROM_EMAIL's domain MUST be verified in the Resend account.
RESEND_FROM_EMAIL=support@goldcoders.dev
RESEND_FROM_NAME=Open Grok Support Team

# The built web console (the Bun/Vite SPA). Set to the directory holding its `index.html` and the
# server serves it at /console; unset means no console route (what the smokes and tests run as).
OG_WEB_CONSOLE_DIR=

# Deployment shape. Unset (or anything but 1) = self-host / dev: Local VM (server-host Docker) is
# offered and used as the computer fallback. OG_HOSTED=1 = hosted / multi-tenant: Local VM is never
# advertised or used (untrusted bot containers must not run on the API host); computers are
# box.ascii.dev / Windows 365 / (later) cloud, configured per-org on the admin dashboard.
OG_HOSTED=
