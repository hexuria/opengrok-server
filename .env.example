# OpenGrok — copy to .env. Every value here is a knob the server reads; nothing is invented
# elsewhere. The full reference with defaults and reasoning: docs/setup/environment.md.

# Where everything listens: the Sand gateway, AG-UI, auth, the console. NOT loopback if a
# desktop client will connect (it refuses a loopback gateway host), and NOT 1337 — grok-bot's
# local-docker box binds that port. 1447 is the convention everywhere.
OG_BIND=0.0.0.0:1447

# Postgres. Default reuses the gateway's dev instance with its own database, so a developer
# runs one database server rather than two. docs/setup/postgres.md.
OG_DATABASE_URL=postgres://oag:oag@127.0.0.1:5452/opengrok

# Signs our access tokens. Required — no default, so two deployments can never share a key by
# accident. Generate with: openssl rand -hex 32
OG_TOKEN_SECRET=

# Encrypts connector credentials at rest. Required once connectors are in use, and deliberately
# without a default: a default would mean every deployment that forgot to set one shares a key,
# and a token sealed on anybody's laptop would open here. Generate with: openssl rand -base64 32
OG_CREDENTIAL_KEK=

# The shared bearer the desktop client presents on every gateway call (its counterpart is the
# token beside the client's OpenGrok gateway URL setting).
OG_GATEWAY_BEARER=

# open-ai-gateway's ADMIN API — how the console mints an org member a gateway key. Deliberately a
# SECOND credential, separate from OG_GATEWAY_TOKEN below: that one is an inference key (what a run
# spends), this one is an admin key (`oag admin key create --email <you> --admin`) and can create
# keys. Unset means the console's "Gateway access" card is off, which is right for a deployment
# that has not wired the two together.
OG_GATEWAY_ADMIN_URL=http://127.0.0.1:29081
OG_GATEWAY_ADMIN_TOKEN=

# The non-loopback address EnsureSandBox mints to clients (e.g. http://192.168.100.24:1447).
# The mint is refused outright when this is loopback or unset.
OG_PUBLIC_GATEWAY_URL=

# The model door. `mock` replays a scripted stream (CI, no spend); `mock-tools` asks for one
# shell call per turn (drives the tool path and consent cards deterministically). Anything else
# exits through the gateway below.
OG_MODEL_DOOR=

# The route a NEW coworker is hired on when the caller names none — a catalogue id, never a key.
# Each coworker keeps its own pin from then on (changeable in the console), so changing this
# retargets nothing that already exists.
#
# The dialect is the gateway's: `provider/model` (`openai/gpt-5.5`), optionally `@api` / `@sub`,
# plus the virtual ladder ids (`oag/auto`, `oag/cheap`, …). A BARE name (`gpt-5.5`) also works on
# a route in passthrough mode, and is what the local bun stub on :8080 lists.
#
# Verified 1 Sep 2026 against the real gateway: a ladder id is only servable if the route has a
# credential for the rung it picks — `oag/auto` was REFUSED there ("no credential available for
# provider anthropic on this route") even though the catalogue advertises it. `POST /models/probe`
# in the console proves a pin before it is saved, which is how that was found.
OG_MODEL=gpt-5.6-luna

# The auto-review judge's route — deliberately not the coworker's own route (the reviewer must
# not be the reviewed). Unset falls back to OG_MODEL.
OG_AUTO_REVIEW_MODEL=

# Mock doors only: the judge's canned one-word verdict (allow | ask | block), for driving
# consent cards with no spend.
OG_AUTO_REVIEW_MOCK_VERDICT=

# open-ai-gateway: the model door. The key is an oag_live_ key and NEVER a provider key —
# a coworker's pin is a route, not a credential (CLAUDE.md #4).
OG_GATEWAY_URL=http://127.0.0.1:29080
OG_GATEWAY_TOKEN=

# Where a coworker's computer comes from. Unset picks box.ascii.dev if OG_BOX_API_KEY is set
# and local Docker otherwise, so a laptop with a Docker daemon needs no account anywhere.
#   docker | ascii | none
OG_COMPUTER=

# box.ascii.dev, for hosted computers that outlive this machine.
OG_BOX_API_KEY=

# Stop an idle box after this many seconds. 0 (the default) disables idle-stop entirely.
OG_BOX_IDLE_STOP_SECONDS=

# The image a Docker computer is built from. Any image with a shell.
OG_DOCKER_IMAGE=debian:stable-slim

# Deployment shape. Unset (or anything but 1) = self-host / dev: Local VM (server-host Docker)
# is offered and used as the computer fallback. OG_HOSTED=1 = hosted / multi-tenant: Local VM is
# never advertised or used (untrusted bot containers must not run on the API host); computers
# are box.ascii.dev / Windows 365 / (later) cloud, configured per-org on the admin dashboard.
OG_HOSTED=

# The host account the desktop roster and sign-in bind to on a single-user deployment.
# Falls back to OG_GATEWAY_EMAIL, then host@opengrok.local.
OG_LOGIN_EMAIL=

# Connector providers: a JSON list of provider configurations. Holds client secrets, so its
# file permissions are the guard. Unset means no connector is offered, which is a valid
# deployment.
#   [{"connector":"gmail","authorize_url":"...","token_url":"...","client_id":"...",
#     "client_secret":"...","scopes":["..."],"offline":true}]
OG_CONNECTORS=

# Where a provider sends a browser back. Must match the app registration byte for byte.
OG_OAUTH_REDIRECT_URI=http://127.0.0.1:1447/connections/callback

# Agent Plugins installed on this server, one directory each. Installing makes a plugin
# available; a coworker still needs its tools in their ceiling before they run.
OG_PLUGINS_DIR=

# Resend (resend.com) — transactional email for signup verification and (later) password reset.
# Unset ⇒ signup auto-verifies (no email). Set ⇒ verification email is sent and required.
# OG_RESEND_API_KEY=re_...
# The sender identity; RESEND_FROM_EMAIL's domain MUST be verified in the Resend account.
RESEND_FROM_EMAIL=support@goldcoders.dev
RESEND_FROM_NAME=Open Grok Support Team

# The built web console (the Bun/Vite SPA). Set to the directory holding its `index.html`
# (normally web/dist) and the server serves it at /console; unset means no console route
# (what the smokes and tests run as).
OG_WEB_CONSOLE_DIR=

# `1` marks the console's auth cookies Secure — set it behind HTTPS.
OG_COOKIE_SECURE=

# Opt-in tonic listener for seam-B gRPC (e.g. 127.0.0.1:1450). Unset means no gRPC socket —
# an unused open port is a liability, not a feature.
OG_GRPC_BIND=

# Tracing. OG_TRACE_REQUESTS=1 additionally logs every request path + status — a diagnostic
# for driving the desktop client end to end; off by default.
RUST_LOG=opengrok=debug,opengrok_server=debug,opengrok_harness=debug
OG_TRACE_REQUESTS=
