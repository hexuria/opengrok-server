# OpenGrok — copy to .env. Every value here is a knob the server reads; nothing is invented
# elsewhere. See docs/RUNBOOK.md §3.

# Where the Sand gateway listens for the desktop client.
# NOT loopback: the client throws if its gateway host starts with 127.0.0.1 or localhost.
# See docs/RUNBOOK.md §1 for the /etc/hosts alias this implies.
OG_BIND=0.0.0.0:1337

# Postgres. Default reuses the gateway's dev instance with its own database, so a developer
# runs one database server rather than two.
OG_DATABASE_URL=postgres://openbot:openbot@127.0.0.1:5452/opengrok

# The shared secret with the desktop client. Must equal SAND_HOST_GATEWAY_TOKEN on the client.
SAND_GATEWAY_TOKEN=

# open-ai-gateway: the model door. The key is an oag_live_ key and NEVER a provider key —
# a coworker's pin is a route, not a credential (CLAUDE.md #4).
OG_GATEWAY_URL=http://127.0.0.1:29080
OG_GATEWAY_TOKEN=

# box.ascii.dev: the coworker's computer. Needed from P3; unset is fine before then.
OG_BOX_API_KEY=

RUST_LOG=opengrok=debug,opengrok_server=debug,opengrok_harness=debug
