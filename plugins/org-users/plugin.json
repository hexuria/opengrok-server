{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "org-users",
  "version": "0.2.0",
  "description": "Ground people tokens from org accounts and related fields before any model call. Resolvers are data sources, not MCP lookup tools.",
  "keywords": ["tmp", "user", "grounding"],
  "extensions": {
    "app.opengrok.tmp": {
      "trigger": "#",
      "mention": "person",
      "tokens": [
        {
          "name": "user",
          "displayName": "Person",
          "required": true,
          "implicit": true,
          "bareAt": true,
          "ui": "list",
          "resolver": "org-accounts"
        },
        {
          "name": "years",
          "displayName": "Years",
          "required": false,
          "implicit": false,
          "ui": "number",
          "resolver": "value",
          "validate": { "type": "integer", "min": 1, "max": 120 }
        },
        {
          "name": "role",
          "displayName": "Role",
          "required": false,
          "implicit": true,
          "ui": "choice",
          "resolver": "plugin-file",
          "source": "roles.json"
        },
        {
          "name": "pin",
          "displayName": "PIN",
          "required": false,
          "implicit": false,
          "ui": "text",
          "resolver": "value",
          "validate": { "pattern": "^[0-9]{4,6}$", "minLength": 4, "maxLength": 6, "digits": true }
        }
      ]
    }
  }
}
